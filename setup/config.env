# Shared paths, sourced by every setup/ and scripts/ file.
# NUPLAN_HOME holds the dataset and simulation outputs and needs lots of disk. Point it at
# a big drive by exporting it before running anything, e.g.
#   export NUPLAN_HOME=/media/$USER/ExternalSSD/nuplan

export PROJ_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export EXT_DIR="$PROJ_ROOT/third_party"

# This repository is Diffusion-Planner itself (forked from upstream commit a3a621f).
export DP_ROOT="$PROJ_ROOT"
export NUPLAN_DEVKIT_ROOT="$EXT_DIR/nuplan-devkit"
export TUPLAN_ROOT="$EXT_DIR/tuplan_garage"

# Pinned upstream commits (HEAD as of 2026-10-19) so all four teammates run identical code.
export NUPLAN_DEVKIT_COMMIT="e9241677997dd86bfc0bcd44817ab04fe631405b"
export TUPLAN_COMMIT="b51d5d04fac1bd4389653b9ab2ff73ea88f435a3"

export CONDA_ENV="diffusion_planner"

# nuPlan layout expected by nuplan-devkit's scenario builders:
#   $NUPLAN_DATA_ROOT/nuplan-v1.1/trainval/*.db   <- val split DBs (Val14 reads from here)
#   $NUPLAN_DATA_ROOT/nuplan-v1.1/test/*.db       <- test split DBs (Test14-hard / Test14-random)
#   $NUPLAN_DATA_ROOT/nuplan-v1.1/mini/*.db
#   $NUPLAN_MAPS_ROOT/<city>/...
export NUPLAN_HOME="${NUPLAN_HOME:-$HOME/nuplan}"
export NUPLAN_DATA_ROOT="$NUPLAN_HOME/dataset"
export NUPLAN_MAPS_ROOT="$NUPLAN_DATA_ROOT/maps"
export NUPLAN_EXP_ROOT="$NUPLAN_HOME/exp"
export NUPLAN_MAP_VERSION="nuplan-maps-v1.0"
